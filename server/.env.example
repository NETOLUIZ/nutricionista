# Copie para .env e preencha. NUNCA commitar o .env
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nutricionista?schema=public"
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"
PORT=3333
# Use 1 SOMENTE em produção atrás do Nginx (para o limite de tentativas ver o IP real)
TRUST_PROXY=0
# Dias para eliminar solicitações canceladas/não confirmadas (npm run purge)
RETENTION_DAYS=180
# Origens permitidas (site público), separadas por vírgula
CORS_ORIGINS="http://localhost:5173,https://SEU-USUARIO.github.io"
# URL pública deste servidor (usada nas imagens enviadas)
PUBLIC_URL="http://localhost:3333"
# Credenciais do primeiro acesso (usadas só pelo npm run seed)
ADMIN_EMAIL="juliana@exemplo.com"
ADMIN_PASSWORD="1020304050korentech"
